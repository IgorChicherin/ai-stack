# Copy to .env and edit. .env is not committed.

# Models
SM_MODEL=gemma4:e4b-it-qat
JEV_MODEL=tev1:4b
SUPERMEMORY_VERSION=0.0.8

# Which compose files to use. Pick ONE line (no line = CPU-only containerized Ollama).
# The path separator is ';' on Windows and ':' on Linux/macOS.
#
# Linux with an NVIDIA GPU:
#COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# Windows (Docker Desktop, WSL2) with an NVIDIA GPU:
#COMPOSE_FILE=docker-compose.yml;docker-compose.nvidia.yml
# macOS, or any OS with Ollama running on the host:
#COMPOSE_FILE=docker-compose.yml:docker-compose.host-ollama.yml
#HOST_OLLAMA_URL=http://host.docker.internal:11434
